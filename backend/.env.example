PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ai_revenue_recovery
CORS_ORIGIN=http://localhost:5173

# AI Agent Provider Configuration
# Set LLM_PROVIDER to "gemini", "openai", or "heuristic" (default when no key is set)
LLM_PROVIDER=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Policy Defaults
POLICY_MAX_PAYMENT_RETRIES=3
POLICY_MAX_CUSTOMER_CONTACTS=2
POLICY_MAX_RECOVERY_WINDOW_DAYS=7
POLICY_AUTO_ESCALATION=true
POLICY_HIGH_VALUE_THRESHOLD=25000
POLICY_AI_CONFIDENCE_THRESHOLD=80
